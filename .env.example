DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/childcareviz?sslmode=require
TYPESAFE_API_KEY=
# MAPBOX_TOKEN must be a PUBLIC token (pk.*) — the dashboard receives it via /api/config.
# In Mapbox → Account → Tokens, URL-restrict it to https://childcareviz.onrender.com/
# (plus http://localhost:3000/ if local dev should use it).
MAPBOX_TOKEN=
# Scraper tuning
SCRAPE_CONCURRENCY=5
SCRAPE_DELAY_MS=800
